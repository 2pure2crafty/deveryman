# Everyman launcher systemd unit template.
#
#   sudo cp everyman-launcher.service.example /etc/systemd/system/everyman-launcher.service
#   # edit User/Group/path/port, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now everyman-launcher.service
#
# The front door. Bind to 127.0.0.1; reach over Tailscale on its own HTTPS port
# (e.g. :8445). Set EVERYMAN_CONDUCTOR_URL / EVERYMAN_DPA_URL in the config so
# its per-project links resolve.

[Unit]
Description=Everyman launcher
After=network.target

[Service]
Type=simple
User=change-me
Group=change-me
ExecStart=/usr/bin/php -S 127.0.0.1:7684 -t /opt/everyman/launcher/public
Restart=on-failure

[Install]
WantedBy=multi-user.target
